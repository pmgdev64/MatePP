#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>

// ============================================================
//  Resource IDs - REDESIGNED (No Audio)
// ============================================================
#define IDI_MAIN_ICON           101
#define IDD_SIMPLE_SETTINGS     100
#define IDC_LOOP_CHECK          1004
#define IDC_TOP_MOST_CHECK      1005
#define IDC_PLAY_PAUSE_BTN      1006
#define IDC_NEXT_BTN            1007
#define IDC_PREV_BTN            1008
#define IDC_RELOAD_BTN          1009

// About dialog
#define IDD_ABOUT               101

// ============================================================
//  Resources
// ============================================================

// Icon
IDI_MAIN_ICON ICON "app.ico"

// Manifest
1 24 "mpp.exe.manifest"

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS      VS_FF_DEBUG
#else
FILEFLAGS      0x0L
#endif
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PmgTeam\0"
            VALUE "FileDescription",  "Mate++ - Live Wallpaper & Desktop Customization Tool\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "mpp\0"
            VALUE "LegalCopyright",   "Free to Use & Open-Source. Developed by PmgTeam.\0"
            VALUE "OriginalFilename", "mpp.exe\0"
            VALUE "ProductName",      "Mate++\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ============================================================
//  Settings Dialog - With Unicode symbols
// ============================================================
IDD_SIMPLE_SETTINGS DIALOGEX 0, 0, 280, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mate++ Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // SECTION 1: Playback Options
    CONTROL         "Loop Playlist", IDC_LOOP_CHECK, "BUTTON",
                    WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX | WS_TABSTOP,
                    20, 15, 110, 20

    CONTROL         "Always on Top", IDC_TOP_MOST_CHECK, "BUTTON",
                    WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX | WS_TABSTOP,
                    150, 15, 110, 20

    // Separator line
    LTEXT           "", -1, 15, 45, 250, 1, SS_SUNKEN

    // SECTION 2: Media Controls
    LTEXT           "Media Controls", -1, 20, 55, 100, 12, SS_LEFT

    PUSHBUTTON      "|| Pause", IDC_PLAY_PAUSE_BTN, 20, 72, 72, 25
    PUSHBUTTON      ">> Next", IDC_NEXT_BTN, 100, 72, 72, 25
    PUSHBUTTON      "<< Prev", IDC_PREV_BTN, 180, 72, 72, 25

    // Separator line
    LTEXT           "", -1, 15, 108, 250, 1, SS_SUNKEN

    // SECTION 3: Utilities
    PUSHBUTTON      "Reload", IDC_RELOAD_BTN, 20, 118, 110, 25
    DEFPUSHBUTTON   "Close", IDOK, 150, 118, 110, 25
END

// ============================================================
//  About Dialog
// ============================================================
IDD_ABOUT DIALOGEX 0, 0, 340, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Mate++"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            IDI_MAIN_ICON, -1, 12, 12, 48, 48

    LTEXT           "Mate++", -1, 72, 14, 240, 22, SS_LEFT
    LTEXT           "Live Wallpaper Engine", -1, 72, 38, 240, 16, SS_LEFT

    LTEXT           "", -1, 12, 62, 316, 1, SS_SUNKEN

    LTEXT           "Version:", -1, 12, 78, 60, 12, SS_LEFT
    LTEXT           "1.0.1", -1, 80, 78, 60, 12, SS_LEFT

    LTEXT           "Author:", -1, 12, 98, 60, 12, SS_LEFT
    LTEXT           "PmgTeam (PepperMCGamers / PmgDev64)", -1, 80, 98, 240, 12, SS_LEFT

    LTEXT           "License:", -1, 12, 118, 60, 12, SS_LEFT
    LTEXT           "Free to Use & Open-Source", -1, 80, 118, 240, 12, SS_LEFT

    LTEXT           "Supported Formats:", -1, 12, 142, 100, 12, SS_LEFT
    LTEXT           "GIF, MP4, AVI, WMV, MKV, MOV, WEBM, M4V", -1, 12, 156, 316, 12, SS_LEFT

    LTEXT           "Built with:", -1, 12, 176, 100, 12, SS_LEFT
    LTEXT           "Direct2D + FFmpeg", -1, 80, 176, 240, 12, SS_LEFT

    DEFPUSHBUTTON   "Close", IDOK, 135, 196, 70, 22
END
